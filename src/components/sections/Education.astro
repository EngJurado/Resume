---
import { education } from '../../data/education';
const { withContainer = true } = Astro.props;
---

{withContainer ? (
  <section class="">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-medium text-slate-900 dark:text-white sm:text-2xl">
        Educación
      </h2>
      <div class="mt-6 space-y-9">
        {education.map(edu => (
          <div class="relative pl-5 border-l border-slate-200 dark:border-slate-700">
            <div class="absolute -left-[5px] top-1.5 h-2 w-2 rounded-full bg-teal-600" />
            <div>
              <h3 class="text-[15px] font-medium text-slate-900 dark:text-white">{edu.degree}</h3>
              <p class="text-sm text-teal-700 dark:text-teal-400">{edu.institution}</p>
              <p class="mt-1 text-xs text-slate-600 dark:text-slate-500">{edu.year}</p>
              {edu.notes && (
                <div class="mt-1.5 text-sm text-slate-600 dark:text-slate-300">
                  {edu.notes.split('<br>').map((line, i, arr) => (
                    <>
                      {line}
                      {i < arr.length - 1 && <br />}
                    </>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
) : (
  <div>
    <h2 class="text-xl font-medium text-slate-900 dark:text-white sm:text-2xl">
      Educación
    </h2>
    <div class="mt-6 space-y-9">
      {education.map(edu => (
        <div class="relative pl-5 border-l border-slate-200 dark:border-slate-700">
          <div class="absolute -left-[5px] top-1.5 h-2 w-2 rounded-full bg-teal-600" />
          <div>
            <h3 class="text-[15px] font-medium text-slate-900 dark:text-white">{edu.degree}</h3>
            <p class="text-sm text-teal-700 dark:text-teal-400">{edu.institution}</p>
            <p class="mt-1 text-xs text-slate-600 dark:text-slate-500">{edu.year}</p>
            {edu.notes && (
              <div class="mt-1.5 text-sm text-slate-600 dark:text-slate-300">
                {edu.notes.split('<br>').map((line, i, arr) => (
                  <>
                    {line}
                    {i < arr.length - 1 && <br />}
                  </>
                ))}
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
)}
