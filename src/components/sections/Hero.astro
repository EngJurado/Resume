---
import { profile } from '../../data/profile';
import SocialLinks from '../ui/SocialLinks.astro';
---

<section class="pt-10 sm:pt-12 pb-6">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-5 lg:gap-12">
      <div class="order-2 lg:order-1 lg:col-span-3 flex flex-col items-center text-center lg:items-start lg:text-left">
        <h1 class="text-3xl font-semibold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
          {profile.name}
        </h1>
        <p class="mt-3 text-base text-slate-500 dark:text-slate-400 sm:text-lg">
          {profile.title}
        </p>
        <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-300 sm:text-base max-w-2xl">
          {profile.bio}
        </p>
        <div class="mt-6">
          <SocialLinks />
        </div>
      </div>
      <div class="order-1 lg:order-2 lg:col-span-2 flex items-center justify-center">
        <img
          src="/images/avatar-304.jpg"
          srcset="/images/avatar-192.jpg 192w, /images/avatar-256.jpg 256w, /images/avatar-304.jpg 304w"
          sizes="(max-width: 639px) 192px, (max-width: 1023px) 256px, 304px"
          width="304"
          height="304"
          alt="Foto de perfil"
          fetchpriority="high"
          class="h-48 w-48 sm:h-64 sm:w-64 lg:h-[304px] lg:w-[304px] rounded-full object-cover ring-1 ring-slate-100 dark:ring-slate-800"
        />
      </div>
    </div>
  </div>
</section>
