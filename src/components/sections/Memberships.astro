---
import { memberships } from '../../data/memberships';
const { translations, lang = 'es', withContainer = true } = Astro.props;
const t = translations;
---

{withContainer ? (
  <section class="">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-medium text-slate-900 dark:text-white sm:text-2xl">
        {t.sections.memberships}
      </h2>
      <div class="mt-6 space-y-4">
        {memberships.map(membership => (
          <div>
             <h3 class="text-[15px] font-medium text-slate-900 dark:text-white">{membership.society[lang]}</h3>
             <p class="text-sm text-teal-700 dark:text-teal-400">{membership.role[lang]}</p>
             <p class="text-xs text-slate-600 dark:text-slate-500">{lang === 'es' ? 'Desde ' : 'Since '}{membership.since}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
) : (
  <div>
    <h2 class="text-xl font-medium text-slate-900 dark:text-white sm:text-2xl">
      {t.sections.memberships}
    </h2>
    <div class="mt-6 space-y-4">
      {memberships.map(membership => (
        <div>
           <h3 class="text-[15px] font-medium text-slate-900 dark:text-white">{membership.society[lang]}</h3>
           <p class="text-sm text-teal-700 dark:text-teal-400">{membership.role[lang]}</p>
           <p class="text-xs text-slate-600 dark:text-slate-500">{lang === 'es' ? 'Desde ' : 'Since '}{membership.since}</p>
        </div>
      ))}
    </div>
  </div>
)}
