---
import { skills } from '../../data/skills';
---

<div>
  <h2 class="text-xl font-medium text-slate-900 dark:text-white sm:text-2xl">
    Habilidades
  </h2>
  <div class="mt-6 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
    {skills.map(category => (
      <div>
        <h3 class="text-xs font-medium text-slate-600 dark:text-slate-500 uppercase tracking-wider">
          {category.category}
        </h3>
        <ul class="mt-3 space-y-2">
          {category.items.map(item => (
            <li class="text-sm text-slate-700 dark:text-slate-300">{item}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</div>
