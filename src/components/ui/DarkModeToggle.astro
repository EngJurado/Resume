---
import { Sun, Moon } from '@lucide/astro';
const STORAGE_KEY = 'theme';
const { translations } = Astro.props;
const ariaLabel = translations.nav.themeToggle;
---

<button
  id="theme-toggle"
  type="button"
  role="switch"
  aria-checked="false"
  aria-label={ariaLabel}
  class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1.5 text-xs font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-100 dark:text-slate-400 dark:hover:text-white dark:hover:bg-slate-800 transition-colors"
>
  <span class="sr-only">{ariaLabel}</span>
  <Sun id="sun-icon" size={14} class="hidden" />
  <Moon id="moon-icon" size={14} class="hidden" />
  <span id="theme-label" class="hidden sm:inline"></span>
</button>

<script is:inline>
  (function() {
    const toggle = document.getElementById('theme-toggle');
    const sunIcon = document.getElementById('sun-icon');
    const moonIcon = document.getElementById('moon-icon');
    const themeLabel = document.getElementById('theme-label');

    if (!toggle || !sunIcon || !moonIcon) return;

    const updateUI = (dark) => {
      toggle.setAttribute('aria-checked', String(dark));
      sunIcon.classList.toggle('hidden', !dark);
      moonIcon.classList.toggle('hidden', dark);
      if (themeLabel) {
        themeLabel.textContent = dark ? 'Dark' : 'Light';
      }
    };

    updateUI(document.documentElement.classList.contains('dark'));

    toggle.addEventListener('click', () => {
      const current = document.documentElement.classList.contains('dark');
      const next = !current;
      document.documentElement.classList.toggle('dark', next);
      localStorage.setItem(STORAGE_KEY, next ? 'dark' : 'light');
      updateUI(next);
    });
  })();
</script>
