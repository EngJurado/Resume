---
import SkipLink from '../components/layout/SkipLink.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/inter-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url('/fonts/inter-latin-ext.woff2') format('woff2');
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }
    </style>
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Portfolio profesional de Carlos Mateo Jurado Díaz - Bioingeniero especializado en neuromodulación, IA en salud y bioinstrumentación." />
    <meta property="og:title" content="Carlos" />
    <meta property="og:description" content="Portfolio profesional de Carlos Mateo Jurado Díaz" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://engjurado.me/" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Carlos" />
    <meta name="twitter:description" content="Portfolio profesional de Carlos Mateo Jurado Díaz" />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Carlos Mateo Jurado Díaz',
      url: 'https://engjurado.me',
      sameAs: [
        'https://www.linkedin.com/in/engjurado/',
        'https://github.com/engjurado'
      ]
    })} />
    <slot name="head" />
    <script is:inline>
      (function() {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const isDark = stored ? stored === 'dark' : prefersDark;
        if (isDark) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col antialiased bg-white text-slate-900 dark:bg-slate-950 dark:text-slate-100">
    <SkipLink />
    <main id="main">
      <slot />
    </main>
  </body>
</html>
